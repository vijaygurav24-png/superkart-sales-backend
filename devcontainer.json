{
  "name": "SuperKart Backend",
  "image": "mcr.microsoft.com/vscode/devcontainers/python:1-3.11-bookworm",
  "remoteUser": "vscode",
  "forwardPorts": [
    7860
  ],
  "portsAttributes": {
    "7860": {
      "label": "SuperKart Flask API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r backend_files/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
